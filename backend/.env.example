# ── Application ────────────────────────────────────────────────────────────────
APP_NAME="Intervexa API"
APP_VERSION="0.1.0"
APP_ENV="development"      # development | staging | production
DEBUG=true

# ── Server ─────────────────────────────────────────────────────────────────────
HOST="0.0.0.0"
PORT=8000

# ── CORS ───────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins, or "*" for all
ALLOWED_ORIGINS=["*"]

# --- LLM ------------------------------------------------------------
LLM_PROVIDER="gemini"
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
GEMINI_MODEL="gemini-2.5-flash"